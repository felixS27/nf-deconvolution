/*
 * nextflow.config
 *
 * Pipeline mechanics (process resources, container engine, execution
 * profiles) and per-experiment params in one file — edit the `params`
 * block below for your dataset/microscope; nothing else should need to
 * change for a normal run.
 *
 * Constraint: all images in one run must share the same microscope
 * settings (NA, ni, voxel size)
 *
 * Apptainer is always enabled, and SLURM is the default executor (see
 * below) — this pipeline is meant to run containerized, on the cluster,
 * by default. `-profile stub` overrides both — no container, local
 * executor, tiny resource footprint — for fast `-stub-run` testing.
 *
 */

workflow.output.mode = 'copy'
workflow.output.overwrite = true

nextflow.enable.moduleBinaries = true

docker.enabled = false
conda.enabled  = false
podman.enabled = false

apptainer {
    enabled      = true
    autoMounts   = true
    pullTimeout  = 3.h
    cacheDir     = "/scratch/${System.getenv('USER')}/apptainer_cache/"
    envWhitelist = ['CUDA_VISIBLE_DEVICES']
    runOptions   = '-H $PWD'
}

env {
    TMPDIR = '$PWD/tmp'
}

params {
    // Input manifest CSV: image_id, emission, channel_index, path,
    // optional time_points/scene — see README for the column contract.
    input = "$projectDir/data/test_input.csv"

    // Microscope optics.
    microscope_ni = 1.33
    microscope_NA = 1.27

    // Deconvolution (dw) settings.
    deconvolution_iter      = 20
    deconvolution_tile_size = null  // set an integer to enable tiling; module enforces a 128px floor when set

    // GPU by default, with automatic CPU fallback on failure — set false
    // to skip GPU entirely (see subworkflows/deconvolution/main.nf).
    deconvolution_with_gpu = true

    // Where published OME-Zarr results are written (see main.nf's output block).
    outdir = 'results'
}

process {
    // Default SLURM partition; overridden below where a process needs a
    // different one (GPU, or CPU-fallback's larger memory footprint).
    maxRetries    = 3
    maxErrors     = -1
    queue = { (task.time <= 14.d && task.memory < 256.GB && (task.memory/task.cpus) <= 4.GB) ? "htc-el8" : "bigmem" }

    withName: 'CONVERT_TO_TIF' {
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }

    withName: 'CONVERT_TO_OME_ZARR' {
        cpus   = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }

    withName: 'DECONWOLF_GPU' {
        cpus              = 4
        memory            = { 32.GB * task.attempt }
        time              = { 4.h * task.attempt }
        queue             = 'gpu-el8'
        containerOptions  = '--nv'
        clusterOptions    = '--gres=gpu:1'
    }

    withName: 'DECONWOLF_CPU' {
        cpus   = { 16 * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: 'DECONWOLF_GPU|DECONWOLF_CPU' {
        ext.float = false
        ext.bq    = 2
        ext.scale = 0
    }
}

executor {
    name            = 'slurm'
    queueSize       = 100
    submitRateLimit = '10/1sec'
    pollInterval    = 10.s
    exitReadTimeout = 5.m
}

profiles {
    // -stub-run testing: no container, local executor, minimal resources
    // regardless of what each process normally requests.
    stub {
        apptainer.enabled = false
        params.input      = "$projectDir/data/test_input.csv"

        process {
            executor = 'local'

            withName: '.*' {
                cpus             = 1
                memory           = 256.MB
                time             = 5.m
                queue            = null
                clusterOptions   = null
                container        = null
                containerOptions = null
            }
        }
    }
}
